+def _cued_statements(conn, params, target, text, query_embedding, lexical_scores, vector_keys, known, *, limit,
+                     include_speech):
+    """One statement for each message whose cues match the query, in cue order, each with its cue score, and the
+    rows of those not in ``known``, to be remembered. A cue belongs to one revision of a message."""
+    events = message_cues.ranked_events(conn, params, text, query_embedding, limit=limit)
+    chosen, fetched = _message_statements(conn, params, target, [(event, revision) for event, revision, _ in events],
+                                          lexical_scores, vector_keys, known, include_speech=include_speech)
+    return [(chosen[(event, revision)], score) for event, revision, score in events
+            if (event, revision) in chosen], fetched
+
+
+def _cue_siblings(conn, params, target, seeds, documents, lexical_scores, vector_keys, *, limit, include_speech):
+    """Statements of messages that share a cue with a message already found, each with a share of that score.
+
+    A question often words itself like one of the messages that answer it and unlike the others. If the found
+    message carries the cue "Ana job", the other messages under that cue are what the question is also about.
+    """
+    if message_cues.SIBLING_WEIGHT <= 0:
+        return {}, []
+    found = {}
+    for item in seeds[:message_cues.SIBLING_SEEDS]:
+        memory = documents[(item["memory_id"], item["revision"])]
+        refs = [ref for ref in memory["evidence_refs"] if ref["relationship"] == "supports"]
+        if memory["derivation"]["method"] == "direct_capture" and len(refs) == 1:
+            event = (refs[0]["event_id"], refs[0]["event_revision"])
+            found[event] = max(found.get(event, 0.0), item["score"])
+    siblings = message_cues.sharing(conn, params, found, limit=limit)
+    chosen, fetched = _message_statements(conn, params, target, list(siblings), lexical_scores, vector_keys,
+                                          documents, include_speech=include_speech)
+    scores = {}
+    for event, score in siblings.items():
+        if event in chosen:
+            scores[chosen[event]] = max(scores.get(chosen[event], 0.0), score)
+    return scores, fetched
+
+
