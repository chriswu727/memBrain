+def sharing(conn, params, found: dict, *, limit) -> dict:
+    """Messages that share a cue phrase with one of ``found`` (``(event_id, event_revision)`` to score), as
+    ``(event_id, event_revision)`` to ``SIBLING_WEIGHT`` times the best score among the found messages it shares
+    a phrase with. Phrases carried by more than ``SIBLING_MEMBERS`` messages are not followed."""
+    if not found or limit <= 0 or SIBLING_WEIGHT <= 0:
+        return {}
+    own = conn.execute(
+        "SELECT event_id,event_revision,string_to_array(cue_text,'; ') AS phrases FROM memory_message_cues "
+        "WHERE tenant_id=%s AND owner_id=%s AND brain_id=%s AND event_id=ANY(%s::text[])",
+        (*params, sorted({event for event, _ in found}))).fetchall()
+    best = {}
+    for row in own:
+        score = found.get((row["event_id"], row["event_revision"]))
+        for phrase in row["phrases"] if score is not None else ():
+            best[phrase] = max(best.get(phrase, 0.0), score)
+    if not best:
+        return {}
+    rows = conn.execute(
+        "SELECT event_id,event_revision,string_to_array(cue_text,'; ') AS phrases FROM memory_message_cues "
+        "WHERE tenant_id=%s AND owner_id=%s AND brain_id=%s AND string_to_array(cue_text,'; ') && %s::text[] "
+        "ORDER BY event_id LIMIT %s", (*params, sorted(best), TERM_ROWS)).fetchall()
+    members = {}
+    for row in rows:
+        for phrase in row["phrases"]:
+            if phrase in best:
+                members[phrase] = members.get(phrase, 0) + 1
+    scores = {}
+    for row in rows:
+        key = (row["event_id"], row["event_revision"])
+        if key in found:
+            continue
+        shared = [best[phrase] for phrase in row["phrases"] if phrase in best and members[phrase] <= SIBLING_MEMBERS]
+        if shared:
+            scores[key] = SIBLING_WEIGHT * max(shared)
+    return dict(sorted(scores.items(), key=lambda value: (-value[1], value[0]))[:limit])
+
+
