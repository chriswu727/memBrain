+@pytest.mark.parametrize("query,texts", [
+    ("blue green", ["The blue map belongs to Mara. The green cup belongs to Leo.", "", "unrelated"]),
+    ("备考安静", ["备考时需要安静。周末去散步。", "心安。宁静。", "不要打扰我。"]),
+    ("not unless workshop 2.5", ["Do not visit unless invited.", "The workshop starts at 2.5 hours."]),
+])
+def test_repeated_passage_scores_match_uncached_ranking(query, texts):
+    from membrain import cognition
+
+    for origins in (None, [{number % 2} for number in range(len(texts))]):
+        scorer = LexicalScorer(query, texts, origins=origins)
+        reference = LexicalScorer(query, texts, origins=origins)
+        for text in [*texts, *reversed(texts), *texts]:
+            expected = max((reference._score(cognition._terms(text[start:end]))
+                            for start, end in cognition._sentence_spans(text)), default=0.0)
+            expected = expected or reference._score(cognition._terms(text))
+            assert scorer(query, text) == expected
+
+
+def test_passage_score_reuse_includes_zero_and_is_local_to_its_corpus(monkeypatch):
+    from collections import Counter
+
+    from membrain import cognition
+
+    original, calls = cognition._sentence_spans, Counter()
+
+    def counted(text):
+        calls[text] += 1
+        return original(text)
+
+    monkeypatch.setattr(cognition, "_sentence_spans", counted)
+    first = LexicalScorer("amber green", ["amber", "green"])
+    second = LexicalScorer("amber green", ["amber", "green", "amber island"])
+    for text in ("amber", "unrelated"):
+        assert first("amber green", text) == first("amber green", text)
+        assert calls[text] == 1
+        second("amber green", text)
+        assert calls[text] == 2
+    assert first("amber green", "amber") != second("amber green", "amber")
+    for number in range(1000):
+        first("amber green", f"label{number:05d}")
+    assert len(first._score_cache) == 512 and first._scored_characters <= 65536
+    large = "山" * 65537
+    for _ in range(2):
+        first("amber green", large)
+    assert large not in first._score_cache and calls[large] == 2
+
+
+def test_passage_score_cache_character_limit_precedes_entry_limit():
+    scorer = LexicalScorer("blue map", [])
+    for number in range(100):
+        scorer("blue map", f"label{number:05d} " + "garden " * 150)
+    assert scorer._scored_characters <= 65536 and len(scorer._score_cache) < 512
+
+
