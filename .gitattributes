plugins/membrain/bin/*.cmd text eol=crlf

# Source archives (git archive, and GitHub's archive downloads that the plugin launchers install the runtime from)
# leave out what neither building nor running memBrain uses: evaluation records (most of the repository's size) and
# the test suite. The OpenClaw and AstrBot install instructions take integrations/ from the same archive; keep it.
/evaluations export-ignore
/tests export-ignore
