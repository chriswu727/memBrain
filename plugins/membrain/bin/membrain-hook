#!/bin/sh
# WorkBuddy / CodeBuddy hook launcher: membrain-hook <event>. Hook JSON arrives on stdin; never fails the host.
# `start` installs or updates the runtime and starts the service in the background (these hosts have no async hooks).
# Without uvx on the path, uv runs the runtime with `uv tool run`, the command uvx stands for. Without either, or
# before the runtime can run, session-start tells the agent so, since the runtime that would say it is missing.
package=${MEMBRAIN_PACKAGE:-"membrain-ai[embedded,semantic] @ https://github.com/chriswu727/membrain/archive/b465c4b773e97d2fcd09525d200397abd0754b37.zip"}
if command -v uvx >/dev/null 2>&1; then run=uvx; elif command -v uv >/dev/null 2>&1; then run="uv tool run"; else run=; fi
notice() {
  [ "$1" = session-start ] && printf '%s\n' "{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"$2\"}}"
}
if [ -z "$run" ]; then
  notice "$1" "memBrain is installed but cannot run: uv was not found on this computer, so nothing is remembered or recalled. In your first reply, tell the user this once and ask them to install uv from https://docs.astral.sh/uv/ and then start a new session."
  exit 0
fi
if [ "$1" = start ]; then
  command -v uv >/dev/null 2>&1 || exit 0
  ( uv tool install --quiet --python 3.12 "$package"; $run --offline --python 3.12 --from membrain-ai membrain plugin start ) </dev/null >/dev/null 2>&1 &
  exit 0
fi
# A hook never waits on uv's tool lock: while uv installs or updates the runtime, it gives up after 2 seconds.
UV_LOCK_TIMEOUT=2 $run --offline --python 3.12 --from membrain-ai membrain plugin hook "$1" --host workbuddy 2>/dev/null && exit 0
notice "$1" "memBrain is installed but its runtime is not ready yet, so nothing is remembered or recalled until it is. It installs in the background; the first time needs an internet connection and takes a few minutes. Memory then starts by itself; no new session is needed. In your first reply, tell the user this once, and that if they see it again in a later session the installation is failing, for example without an internet connection."
exit 0
