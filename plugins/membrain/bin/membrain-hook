#!/bin/sh
# WorkBuddy / CodeBuddy hook launcher: membrain-hook <event>. Hook JSON arrives on stdin; never fails the host.
# `start` installs or updates the runtime and starts the service in the background (these hosts have no async hooks).
package=${MEMBRAIN_PACKAGE:-"membrain-ai[embedded,semantic] @ https://github.com/chriswu727/membrain/archive/5d0475d4e318a224bdfab7921eb75b209e42d80e.zip"}
if [ "$1" = start ]; then
  command -v uv >/dev/null 2>&1 || exit 0
  ( uv tool install --quiet --python 3.12 "$package"; uvx --offline --python 3.12 --from membrain-ai membrain plugin start ) </dev/null >/dev/null 2>&1 &
  exit 0
fi
command -v uvx >/dev/null 2>&1 && uvx --offline --python 3.12 --from membrain-ai membrain plugin hook "$1" --host workbuddy 2>/dev/null
exit 0
